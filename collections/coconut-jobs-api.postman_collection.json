  "info": {
    "_postman_id": "65edaa1d-0db0-4091-96e6-39e40e3f624f",
    "name": "Coconut Jobs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Coconut API v2 is a cloud video and audio encoding/transcoding service. A single asynchronous job transcodes a source media file into multiple output formats, packages adaptive HLS/MPEG-DASH streams, and generates thumbnails and GIF animations, delivering results to cloud storage and reporting progress through webhooks. Authentication is HTTP Basic with the API key as the username and a blank password.\n\nContact Support:\n Name: Coconut Support\n Email: team@coconut.co",
      "type": "text/plain"
    }
  }
