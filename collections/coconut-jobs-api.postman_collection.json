          "name": "Create a job",
          "request": {
            "name": "Create a job",
            "description": {
              "content": "Submit a new encoding job. A single request defines the input source, storage destination, desired outputs, optional notification webhook, and optional settings (such as ultrafast parallel transcoding). The job runs asynchronously and progress is reported via the notification webhook when configured.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"url\": \"<uri>\",\n    \"service\": \"<string>\",\n    \"bucket\": \"<string>\",\n    \"credentials\": {\n      \"access_key_id\": \"<string>\",\n      \"secret_access_key\": \"<string>\"\n    }\n  },\n  \"storage\": {\n    \"service\": \"<string>\",\n    \"region\": \"<string>\",\n    \"bucket\": \"<string>\",\n    \"path\": \"<string>\",\n    \"credentials\": {\n      \"access_key_id\": \"<string>\",\n      \"secret_access_key\": \"<string>\"\n    }\n  },\n  \"outputs\": {\n    \"key_0\": {\n      \"path\": \"<string>\",\n      \"url\": \"<uri>\",\n      \"if\": \"<string>\",\n      \"number\": \"<integer>\"\n    },\n    \"key_1\": {\n      \"path\": \"<string>\",\n      \"url\": \"<uri>\",\n      \"if\": \"<string>\",\n      \"number\": \"<integer>\"\n    }\n  },\n  \"notification\": {\n    \"type\": \"<string>\",\n    \"url\": \"<uri>\",\n    \"events\": false,\n    \"metadata\": false\n  },\n  \"settings\": {\n    \"ultrafast\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
